# API 与数据库凭据填写模板（无真实密钥，可以提交到仓库）。
# 复制为同目录 credentials.env 后填写；私有文件禁止提交或打包到镜像。
# 在后端目录显式加载：
# uv run --env-file config/credentials.env python -m app.check_config
# 应用自身不自动读取此文件；已有进程环境变量优先于文件中的值。
# 值用单引号包裹，可保留空格、#、$ 和反斜杠；值本身含单引号时需按 dotenv 语法转义。
# 不需要的服务保持空值或注释；填写参数不代表已经接通服务。
# uv 遇到部分语法错误只警告并继续，警告可能显示原始出错行；先修正再启动，不要分享警告原文。

# 一、后端 API：用于健康探测的地址，不控制 uvicorn 的监听端口。
EOV_API_BASE_URL='http://127.0.0.1:8000'
EOV_DEPLOYMENT_NAME='local_single_process'
# 可选：明确允许的跨域来源，用英文逗号分隔；空值表示关闭跨域。
# EOV_CORS_ORIGINS='http://localhost:5173'
# 高级非敏感参数继续使用 TOML；不需要时不要取消下面的注释。
# EOV_CONFIG_FILE='config/services.toml'

# 二、DeepSeek：仅 AI 制作 CLI 需要；HTTP 启动和普通检查不会调用模型。
# API 地址不带账号、密码、query 或 fragment；本项目 CLI 默认使用下列服务。
LLM_API_BASE_URL='https://api.deepseek.com'
LLM_MODEL='deepseek-flash'
DEEPSEEK_API_KEY=''
# 旧服务配置的 LLM_API_KEY 不是 DeepSeek CLI 默认密钥；通常不需要填写。
# LLM_API_KEY=''
# AI 命令仍需 --allow-model-calls 和有效的已授权请求预算，不能通过换文件重置预算。

# 三、本机后端使用的数据库：空值保留本地 SQLite（除非已有环境变量覆盖）。
# 完整 PostgreSQL 格式：postgresql+psycopg://用户名:编码后的密码@主机:端口/数据库名
# 示例仅说明格式，不是真实账号：
# DATABASE_URL='postgresql+psycopg://demo_user:example%40password@127.0.0.1:5432/demo_db'
# 用户名或密码内的 @ : / # % ? 等特殊字符须做 URL 百分号编码；只编码对应组件。
# 例如密码中的 @ 写成 %40，# 写成 %23，% 写成 %25；不要对整条 URL 编码。
# 主机、端口、用户名、密码、库名均按实际环境填写，不要直接使用示例连接业务库。
DATABASE_URL=''

# 四、可选 Redis：当前只读查询不依赖 Redis，通常保持空值。
# 格式：redis://用户名:编码后的密码@主机:端口/库编号
# 默认用户可写为 redis://:编码后的密码@127.0.0.1:6379/0
REDIS_URL=''

# 五、原项目多服务 Docker 部署预留参数：当前 backend/compose.yaml 使用 SQLite，不读取这组字段。
# 仅复用原项目多服务部署配置时填写；原配置固定用户名 echoes、数据库名 echoes。
# 容器内部数据库主机 postgres:5432，Redis 主机 redis:6379，连接串由 Compose 生成。
# Compose 不使用上面的 DATABASE_URL / REDIS_URL；本机程序和容器地址不可混用。
# 两个密码使用足够长的随机十六进制字符串，避免现有连接串拼接中的 URL 特殊字符。
# 已有数据卷的数据库密码不会因修改本文件自动更新；已有环境请使用匹配的凭据。
POSTGRES_PASSWORD=''
REDIS_PASSWORD=''
HTTP_PORT=8080

# 六、预留 Embedding：未接入，不要求填写，也不会因填写而启用。
EMBEDDING_API_BASE_URL=''
EMBEDDING_MODEL=''
EMBEDDING_API_KEY=''

# 七、预留对象存储：未接入上传/下载服务，不要求填写。
EOV_STORAGE_ENDPOINT=''
EOV_STORAGE_REGION=''
EOV_STORAGE_BUCKET=''
EOV_STORAGE_ACCESS_KEY_ID=''
EOV_STORAGE_SECRET_ACCESS_KEY=''
EOV_STORAGE_SESSION_TOKEN=''
