      {
        "contentVersion": "shuidiaogetou-3",
        "contentStatus": "draft",
        "id": "shuidiaogetou",
        "title": "水调歌头",
        "form": "ci",
        "author": "苏轼",
        "dynasty": "宋",
        "genre": "咏月",
        "first": "明月几时有",
        "preface": "丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由。",
        "stanzas": [
          [
            "明月几时有？把酒问青天。",
            "不知天上宫阙，今夕是何年。",
            "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。",
            "起舞弄清影，何似在人间。"
          ],
          [
            "转朱阁，低绮户，照无眠。",
            "不应有恨，何事长向别时圆？",
            "人有悲欢离合，月有阴晴圆缺，此事古难全。",
            "但愿人长久，千里共婵娟。"
          ]
        ],
        "acts": [
          {
            "n": "一",
            "t": "把酒问月"
          },
          {
            "n": "二",
            "t": "欲往琼楼"
          },
          {
            "n": "三",
            "t": "清影与共月"
          }
        ],
        "imagery": [
          {
            "name": "明月",
            "line": "明月几时有？把酒问青天。",
            "clip": "你在庭院抬头，月光落在杯沿，像一句尚未说完的问话。",
            "note": "中秋之月象征团圆。苏轼作此词时，与弟弟苏辙已多年未见，月成为跨越距离的共同见证。",
            "src": "《东坡乐府》；丙辰中秋词序",
            "art": "moon"
          },
          {
            "name": "酒杯",
            "line": "把酒问青天。",
            "clip": "石桌上只一只青瓷杯，静待你举起。",
            "note": "“把酒”即持酒杯。宋人常以酒入诗，借醉意抒写难以直言的情思。",
            "src": "《苏轼词编年校注》",
            "art": "cup"
          },
          {
            "name": "清影",
            "line": "起舞弄清影，何似在人间。",
            "clip": "石径上的影子随你起落，仿佛另一个同行者。",
            "note": "“清影”是月下独舞时的影子，诗人由此体会到人间的真实与可亲。",
            "src": "《宋词三百首笺注》",
            "art": "shadow"
          }
        ],
        "art": "moon",
        "content_review_status": "demo_unreviewed"
      }
    ],
    "total": 1,
    "limit": 20,
    "offset": 0
  },
