{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "chunkId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Chunkid",
          "type": "string"
        },
        "quote": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "chunkId",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Claimid",
          "type": "string"
        },
        "targetId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Targetid",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "original",
            "historical",
            "interpretation",
            "game_creation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sourceQuote": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcequote"
        }
      },
      "required": [
        "claimId",
        "targetId",
        "text",
        "kind"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "promptTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompttokens"
        },
        "completionTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completiontokens"
        },
        "totalTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Totaltokens"
        }
      },
      "required": [
        "attempt",
        "model"
      ],
      "title": "Usage",
      "type": "object"
    },
    "ValidationEntry": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "$ref": "#/$defs/Claim"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "verdict",
        "evidence"
      ],
      "title": "ValidationEntry",
      "type": "object"
    },
    "Verdict": {
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Claimid",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "contradicted",
            "insufficient",
            "conflicting"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 6,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "claimId",
        "status",
        "explanation",
        "citations"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "publication": {
      "const": "draft",
      "default": "draft",
      "title": "Publication",
      "type": "string"
    },
    "humanReview": {
      "const": "unreviewed",
      "default": "unreviewed",
      "title": "Humanreview",
      "type": "string"
    },
    "poemId": {
      "const": "su_shi.shuidiaogetou",
      "default": "su_shi.shuidiaogetou",
      "title": "Poemid",
      "type": "string"
    },
    "contentVersion": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Contentversion",
      "type": "string"
    },
    "contentDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contentdigest",
      "type": "string"
    },
    "corpusDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Corpusdigest",
      "type": "string"
    },
    "promptVersion": {
      "default": "sdt-ai-2",
      "enum": [
        "sdt-ai-1",
        "sdt-ai-2"
      ],
      "title": "Promptversion",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "retrievalMethod": {
      "const": "jieba-bm25",
      "default": "jieba-bm25",
      "title": "Retrievalmethod",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ValidationEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "skippedCreations": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Skippedcreations",
      "type": "array"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/Usage"
      },
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "contentVersion",
    "contentDigest",
    "corpusDigest",
    "model",
    "entries",
    "skippedCreations",
    "usage"
  ],
  "title": "ValidationReport",
  "type": "object"
}
