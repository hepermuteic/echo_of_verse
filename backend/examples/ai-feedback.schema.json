{
  "$defs": {
    "FeedbackNode": {
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Eventid",
          "type": "string"
        },
        "segmentIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Segmentids",
          "type": "array"
        },
        "poeticExplanation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Poeticexplanation",
          "type": "string"
        },
        "emotionalInterpretation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Emotionalinterpretation",
          "type": "string"
        }
      },
      "required": [
        "eventId",
        "segmentIds",
        "poeticExplanation",
        "emotionalInterpretation"
      ],
      "title": "FeedbackNode",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "promptTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompttokens"
        },
        "completionTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completiontokens"
        },
        "totalTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Totaltokens"
        }
      },
      "required": [
        "attempt",
        "model"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/FeedbackNode"
      },
      "maxItems": 5,
      "title": "Nodes",
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "publication": {
      "const": "draft",
      "default": "draft",
      "title": "Publication",
      "type": "string"
    },
    "humanReview": {
      "const": "unreviewed",
      "default": "unreviewed",
      "title": "Humanreview",
      "type": "string"
    },
    "inputStatus": {
      "enum": [
        "reference_fixture",
        "caller_snapshot_unverified"
      ],
      "title": "Inputstatus",
      "type": "string"
    },
    "deviceAcceptance": {
      "const": "unverified",
      "default": "unverified",
      "title": "Deviceacceptance",
      "type": "string"
    },
    "contentVersion": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Contentversion",
      "type": "string"
    },
    "contentDigest": {
      "title": "Contentdigest",
      "type": "string"
    },
    "journeyId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Journeyid",
      "type": "string"
    },
    "snapshotDigest": {
      "title": "Snapshotdigest",
      "type": "string"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "emotionalStatus": {
      "const": "literary_inference_not_measured_player_emotion",
      "default": "literary_inference_not_measured_player_emotion",
      "title": "Emotionalstatus",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "promptVersion": {
      "const": "sdt-feedback-1",
      "default": "sdt-feedback-1",
      "title": "Promptversion",
      "type": "string"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/Usage"
      },
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "inputStatus",
    "contentVersion",
    "contentDigest",
    "journeyId",
    "snapshotDigest",
    "completed",
    "model",
    "usage"
  ],
  "title": "FeedbackReport",
  "type": "object"
}
