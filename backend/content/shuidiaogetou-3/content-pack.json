  "poem": {
    "poemId": "su_shi.shuidiaogetou",
    "title": "水调歌头·明月几时有",
    "author": "苏轼",
    "preface": "丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由。",
    "segments": [
      {
        "segmentId": "sdt.segment.01",
        "order": 0,
        "text": "明月几时有？把酒问青天。"
      },
      {
        "segmentId": "sdt.segment.02",
        "order": 1,
        "text": "不知天上宫阙，今夕是何年。"
      },
      {
        "segmentId": "sdt.segment.03",
        "order": 2,
        "text": "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。"
      },
      {
        "segmentId": "sdt.segment.04",
        "order": 3,
        "text": "起舞弄清影，何似在人间。"
      },
      {
        "segmentId": "sdt.segment.05",
        "order": 4,
        "text": "转朱阁，低绮户，照无眠。"
      },
      {
        "segmentId": "sdt.segment.06",
        "order": 5,
        "text": "不应有恨，何事长向别时圆？"
      },
      {
        "segmentId": "sdt.segment.07",
        "order": 6,
        "text": "人有悲欢离合，月有阴晴圆缺，此事古难全。"
      },
      {
        "segmentId": "sdt.segment.08",
        "order": 7,
        "text": "但愿人长久，千里共婵娟。"
      }
    ],
    "sourceIds": [
      "poem.pending-source"
    ]
  },
